# Caddy auto-provisions Let's Encrypt certs when DOMAIN is a real hostname.
# For localhost (or any *.localhost), Caddy issues an internal cert.
# Set DOMAIN in your environment (or .env) before running compose up.
#
# Teams (docs/TEAMS.md) live on <slug>.ROOT_DOMAIN. Point a wildcard DNS
# record (*.ROOT_DOMAIN) at this host and set ROOT_DOMAIN to the same value
# as DOMAIN. Certificates for team hosts are issued one at a time, on first
# visit, and only after the API confirms the name is ROOT_DOMAIN or a live
# team — so random names pointed at this box cannot burn Let's Encrypt
# rate limits. The ask goes straight to the api container over the compose
# bridge, which TRUSTED_PROXIES covers; the public hostname never reaches
# that route (both site blocks answer /api/internal/* with 404, and the web
# proxy refuses it as well).

{
	on_demand_tls {
		ask http://api:3000/internal/tls/allow
	}
}

{$DOMAIN} {
	encode gzip zstd

	handle /api/internal/* {
		respond 404
	}

	# Forward everything else to the SPA-serving web container, which proxies
	# /api/* to the API container internally. Caddy automatically appends
	# the real client IP to X-Forwarded-For; the API only honors that
	# header for peers in TRUSTED_PROXIES (the docker bridge). The web
	# proxy stamps X-Forwarded-Host with the browser's Host so the API can
	# pick the team.
	handle {
		reverse_proxy web:3001 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# Team subdomains. Falls back to *.localhost (internal cert) when
# ROOT_DOMAIN is unset so a single-tenant compose stack still parses.
*.{$ROOT_DOMAIN:localhost} {
	encode gzip zstd

	tls {
		on_demand
	}

	handle /api/internal/* {
		respond 404
	}

	handle {
		reverse_proxy web:3001 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# Verified team custom domains; the ask endpoint refuses every unverified name.
https:// {
	encode gzip zstd
	tls {
		on_demand
	}
	handle /api/internal/* {
		respond 404
	}
	handle {
		reverse_proxy web:3001 {
			header_up X-Real-IP {remote_host}
		}
	}
}
