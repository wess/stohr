# Keep the build context small — only package.json, bun.lock, src/,
# migrations/, tsconfig.json and scripts/connect.ts are actually COPY'd into
# the image.
# (atlas is fetched by `bun install` from github:wess/atlas.)

# VCS + local
.git
.gitignore
.DS_Store
*.log

# Secrets — never bake these into an image
.env
.env.local
.env.*

# Installed deps (the image installs its own)
node_modules

# Not needed at runtime
tests/
docs/
sdks/
apps/
# scripts/deploy is operator tooling (and holds a .env.local); only the
# connect script ships.
scripts/*
!scripts/connect.ts
biome.json

# Deploy / tooling files (not part of the app)
Dockerfile
.dockerignore
compose.yaml
caddyfile
.do/
.omc/
.remember/
.claude/

# Docs / meta
README.md
SECURITY.md
INTEGRATIONS.md
CLAUDE.md
LICENSE
NOTICE
