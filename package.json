{
  "name": "stohr",
  "version": "0.10.8",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/dev.ts",
    "api": "bun --hot src/server.ts",
    "web": "bun --hot src/web/serve.ts",
    "test": "bun test --concurrency=1 tests/",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/ scripts/",
    "format": "biome format src/ scripts/",
    "check": "biome check src/ scripts/",
    "lint:fix": "biome lint --write src/ scripts/",
    "format:fix": "biome format --write src/ scripts/",
    "check:fix": "biome check --write src/ scripts/",
    "tidy": "bun run format:fix && bun run lint:fix",
    "connect": "bun scripts/connect.ts",
    "check:atlas": "bunx --package https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-cli-0.4.9.tgz atlas check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/qrcode": "^1.5.6",
    "ldapts": "^9.2.0",
    "lucide-react": "^1.64.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "@wess/atlas": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-0.4.9.tgz",
    "@wess/atlas-auth": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-auth-0.4.9.tgz",
    "@wess/atlas-cli": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-cli-0.4.9.tgz",
    "@wess/atlas-config": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-config-0.4.9.tgz",
    "@wess/atlas-db": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-db-0.4.9.tgz",
    "@wess/atlas-migrate": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-migrate-0.4.9.tgz",
    "@wess/atlas-server": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-server-0.4.9.tgz",
    "@wess/atlas-sso": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-sso-0.4.9.tgz",
    "@wess/atlas-storage": "https://github.com/wess/atlas/releases/download/v0.4.9/wess-atlas-storage-0.4.9.tgz"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
